@page
@model BookDetailsModel
@using Markdig
@{
    ViewData["Title"] = Model.Book.Title;
    // DisableHtml: все HTML-теги экранируются, в т.ч. опасные (<script> и др.)
    var pipeline = new MarkdownPipelineBuilder().DisableHtml().Build();
    var descriptionHtml = Markdown.ToHtml(Model.Book.Description, pipeline);
}

<h1>@Model.Book.Title</h1>
<dl class="row">
    <dt class="col-sm-3">Страниц</dt>
    <!-- Razor автоматически экранирует HTML во всех полях, кроме @Html.Raw() ниже -->
    <dd class="col-sm-9">@Model.Book.PageCount</dd>
    <dt class="col-sm-3">@(Model.Book.AuthorNames.Count == 1 ? "Автор" : "Авторы")</dt>
    <dd class="col-sm-9">@string.Join(", ", Model.Book.AuthorNames)</dd>
</dl>
<div>@Html.Raw(descriptionHtml)</div>
